{
  "name": "animasi-lirik-gemini",
  "version": "2.0.0",
  "description": "ProPresenter Lyric Animator with After Effects text animations and wiggle effects",
  "author": "devandika",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "build": {
    "appId": "com.lyricanimator.propresenter",
    "productName": "ProPresenter Animator Lyric",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "ProPresenter Animator Lyric V2.0 Setup.${ext}"
    },
    "portable": {
      "artifactName": "ProPresenter Animator Lyric V2.0.${ext}"
    },
    "mac": {
      "icon": "electron/assets/app-icon.png",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "electron/assets/app-icon.png",
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "tar.gz"
      ]
    }
  },
  "dependencies": {
    "koffi": "^3.3.7",
    "motion": "^14.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-time-picker": "^8.1.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^40.10.2",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.7"
  }
}
